{
  "name": "vue3-annotator",
  "version": "0.1.31",
  "private": true,
  "type": "module",
  "main": "./dist/vue3-annotator.js",
  "module": "./dist/vue3-annotator.js",
  "exports": {
    ".": {
      "import": "./dist/vue3-annotator.js",
      "default": "./dist/vue3-annotator.js"
    },
    "./dist/vue3-annotator.css": "./dist/vue3-annotator.css"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "Vue",
    "Vue.js",
    "NLP",
    "Natural Language Processing",
    "Annotation"
  ],
  "scripts": {
    "dev": "vite",
    "build": "run-p check-types \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "check-types": "vue-tsc --build",
    "postinstall": "bun run build-only"
  },
  "dependencies": {
    "@flatten-js/interval-tree": "^2.0.3",
    "grapheme-splitter": "^1.0.4",
    "uuid": "catalog:",
    "vue": "catalog:",
    "vue-virtual-scroller": "^3.0.4"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^26.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "jest": "^30.4.2",
    "typescript": "catalog:",
    "vite": "^8.0.16",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.9"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "maintained node versions"
  ]
}
